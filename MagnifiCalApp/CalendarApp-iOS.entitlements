<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Same CloudKit private-database container as the macOS app, so both devices sync the
         same calendar. aps-environment enables CKSyncEngine push (near-real-time delivery);
         pair it with the remote-notification background mode in the target's Info settings. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.dev.libirabu.calendar</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <!-- Dev-signed builds default to the DEVELOPMENT CloudKit environment — but the real data
         lives in PRODUCTION (the shipped Mac DMG pushes there since 0.2.0). Without this
         override a fresh phone install fetches an empty dev database and the calendar shows
         nothing. Safe to point a debug build at production: the phone engine is
         cloudReadOnly (fetch-only, sends hard-blocked). The Mac Debug entitlements stay on
         dev deliberately — the Mac shares its local store with the DMG, and flipping its
         env would tangle its saved CKSyncEngine state. -->
    <key>com.apple.developer.icloud-container-environment</key>
    <string>Production</string>
    <key>aps-environment</key>
    <string>development</string>
</dict>
</plist>
